# Frontend-safe public configuration only.
# Supabase URL + anon key are designed to be public client config when RLS is enabled.
# Never expose service-role keys, social access tokens or AI secret keys with VITE_ variables.

VITE_APP_NAME=AZ Multi
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production secrets belong ONLY in server-side deployment settings / functions:
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_SECRET=
# TIKTOK_CLIENT_SECRET=
# X_CLIENT_SECRET=
